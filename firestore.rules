rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidBooking(data) {
      return data.keys().hasOnly([
               'name',
               'phone',
               'aadhaar',
               'checkIn',
               'checkOut',
               'guests',
               'totalAmount',
               'advancePaid',
               'balancePaid',
               'isCancelled',
               'refundedAmount'
             ]) &&
          data.name is string && data.name.size() >= 3 && data.name.size() <= 80 &&
          data.phone is string && data.phone.matches('^[0-9]{10}$') &&
          data.aadhaar is string &&
          (data.aadhaar.size() == 0 || data.aadhaar.matches('^[0-9]{12}$')) &&
          data.checkIn is timestamp &&
          data.checkOut is timestamp &&
          data.checkOut > data.checkIn &&
          data.guests is int && data.guests >= 1 && data.guests <= 99 &&
          data.totalAmount is number && data.totalAmount > 0 &&
          data.advancePaid is number &&
          data.advancePaid >= 0 &&
          data.advancePaid <= data.totalAmount &&
          (!('balancePaid' in data) ||
            (data.balancePaid is number && data.balancePaid >= 0 &&
             data.advancePaid + data.balancePaid <= data.totalAmount + 0.000001)) &&
          (!('isCancelled' in data) || data.isCancelled is bool) &&
          (!('refundedAmount' in data) ||
            (data.refundedAmount is number && data.refundedAmount >= 0 &&
             (data.refundedAmount == 0 ||
               (data.get('isCancelled', false) == true &&
                data.refundedAmount == data.advancePaid +
                  ('balancePaid' in data ? data.balancePaid : 0)))));
    }

    function validBookingTransition(before, after) {
      let wasCancelled = before.get('isCancelled', false);
      let isCancelled = after.get('isCancelled', false);
      return wasCancelled
          ? isCancelled &&
            after.diff(before).affectedKeys().hasOnly(['refundedAmount']) &&
            (before.get('refundedAmount', 0) == 0 ||
             after.get('refundedAmount', 0) == before.get('refundedAmount', 0))
          : isCancelled
            ? after.diff(before).affectedKeys().hasOnly(['isCancelled']) &&
              after.get('refundedAmount', 0) == 0
            : after.get('refundedAmount', 0) == 0;
    }

    function isValidExpense(data) {
      return data.keys().hasOnly([
               'title',
               'amount',
               'description',
               'date'
             ]) &&
          data.title is string && data.title.size() >= 3 && data.title.size() <= 80 &&
          data.amount is number && data.amount > 0 &&
          data.description is string && data.description.size() <= 500 &&
          data.date is timestamp;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
               'name',
               'address',
               'photoBytes',
               'email',
               'updatedAt'
             ]) &&
          data.name is string && data.name.size() >= 3 && data.name.size() <= 80 &&
          data.address is string && data.address.size() >= 10 && data.address.size() <= 250 &&
          data.photoBytes is bytes &&
          (!('email' in data) || data.email is string) &&
          (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAccountProfile(data) {
      return data.keys().hasOnly(['name', 'phone', 'email', 'guestHouseName', 'guestHouseAddress', 'photoBytes', 'houseRules', 'updatedAt']) &&
          data.keys().hasAll(['name', 'phone', 'email', 'photoBytes', 'updatedAt']) &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
          data.phone is string && data.phone.size() <= 30 &&
          data.email is string && data.email.size() <= 254 &&
          (!('guestHouseName' in data) ||
            (data.guestHouseName is string && data.guestHouseName.size() <= 80)) &&
          (!('guestHouseAddress' in data) ||
            (data.guestHouseAddress is string && data.guestHouseAddress.size() <= 250)) &&
          (!('houseRules' in data) ||
            (data.houseRules is string && data.houseRules.size() <= 50000)) &&
          (data.photoBytes == null ||
            (data.photoBytes is bytes && data.photoBytes.size() <= 500000)) &&
          data.updatedAt is timestamp;
    }

    // User bookings
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
          isValidBooking(request.resource.data) &&
          request.resource.data.get('isCancelled', false) == false &&
          request.resource.data.get('refundedAmount', 0) == 0;
      allow update: if isSignedIn() && request.auth.uid == userId &&
          isValidBooking(request.resource.data) &&
          validBookingTransition(resource.data, request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // User expenses
    match /users/{userId}/expenses/{expenseId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidExpense(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // User profile
    match /users/{userId}/profile/{profileId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidProfile(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/account/{document} {
      allow read: if isSignedIn() && request.auth.uid == userId && document == 'profile';
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
          document == 'profile' && isValidAccountProfile(request.resource.data);
    }

    match /users/{userId}/settings/{document} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
          ((document == 'houseRules' &&
            request.resource.data.keys().hasOnly(['body', 'updatedAt']) &&
            request.resource.data.body is string &&
            request.resource.data.body.size() <= 50000 &&
            (!('updatedAt' in request.resource.data) ||
              request.resource.data.updatedAt is timestamp)) ||
           (document == 'website' &&
            request.resource.data.keys().hasOnly(['url', 'updatedAt']) &&
            request.resource.data.keys().hasAll(['url', 'updatedAt']) &&
            request.resource.data.url is string &&
            request.resource.data.url.size() <= 2048 &&
            request.resource.data.updatedAt is timestamp));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
